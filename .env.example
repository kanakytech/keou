# ══════════════════════════════════════════════════════════════
#  Keou — environment
#  Copy to .env and fill in. Only the two REQUIRED values below
#  are mandatory; everything else has a working default.
# ══════════════════════════════════════════════════════════════

# ─── Required ───

# PostgreSQL connection string. Migrations run automatically at boot.
DATABASE_URL=postgresql://user:password@localhost:5432/keou

# Session signing secret, 16 chars minimum.
#   openssl rand -hex 32
JWT_SECRET=

# ─── Storage (strongly recommended) ───
# Cloudflare R2, free tier is enough. Without it the app still runs, but
# uploads fail and results vanish when the provider expires their URLs
# (~14 days).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=keou
R2_PUBLIC_URL=

# ─── Server ───
PORT=3401

# ─── Providers ───
# Every user pastes their own key in the studio; it stays in their browser
# and rides each request. The keys below are only a server-side fallback for
# a private instance where you'd rather not hand keys to each user.
DEFAULT_PROVIDER=kie
# KIE_API_KEY=
# FAL_API_KEY=

# ─── Assistant (optional) ───
# Enables the chat agent that drives the whole toolset. Leave unset and the
# assistant returns a clear error while everything else works normally.
# A key can also be saved from Settings → API Keys instead of here.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Speech-to-text for voice input in the assistant.
# OPENAI_API_KEY=

# ─── First admin (optional) ───
# Seeds an admin account the first time the database comes up empty.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ─── Branding ───
AGENCY_NAME=Keou

# ─── Internal counters ───
# There is no billing in this edition — these are quota counters only.
AGENCY_IMAGE_QUOTA=999999
AGENCY_VIDEO_QUOTA=999999

# ─── Tokens ───
JWT_EXPIRES=15m
REFRESH_EXPIRES=30d

# ─── Managed Postgres with certificate pinning (optional) ───
# DATABASE_SSL_STRICT=1
# DATABASE_CA=

# ─── Scaling ───
# Set to 1 on every replica except one, so a single instance polls providers.
# DISABLE_POLLER=
